{
  "version": 3,
  "configurePresets": [
    {
      "name": "ninja-multiconfig-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/",
      "cacheVariables": {
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/build/external",
        "CMAKE_OPTIMIZE_DEPENDENCIES": "YES",
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo;Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install"
      }
    },
    {
      "name": "minimal-base",
      "hidden": true,
      "cacheVariables": {
        "LOON_GPU_BUILD_EXAMPLES": "NO",
        "LOON_GPU_BUILD_TESTS": "NO",
        "LOON_GPU_BUILD_DOCS": "NO",
        "LOON_GPU_WERROR": "YES",
        "LOON_GPU_INSTALL": "YES"
      }
    },
    {
      "name": "development-base",
      "hidden": true,
      "cacheVariables": {
        "LOON_GPU_BUILD_EXAMPLES": "YES",
        "LOON_GPU_BUILD_TESTS": "YES",
        "LOON_GPU_BUILD_DOCS": "YES",
        "LOON_GPU_WERROR": "YES",
        "LOON_GPU_INSTALL": "YES"
      }
    },
    {
      "name": "windows-clang-base",
      "hidden": true,
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Windows"
        ]
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_CXX_COMPILER": "clang-cl.exe"
      }
    },
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Windows"
        ]
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "macos-clang-base",
      "hidden": true,
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Darwin"
        ]
      },
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "Minimal Windows Clang",
      "displayName": "Minimal",
      "inherits": [
        "ninja-multiconfig-base",
        "minimal-base",
        "windows-clang-base"
      ],
      "hidden": false,
      "description": "Sets Ninja generator, Clang compilers, x64 architecture, Multiple Configurations"
    },
    {
      "name": "Development Windows Clang",
      "displayName": "Development",
      "inherits": [
        "ninja-multiconfig-base",
        "development-base",
        "windows-clang-base"
      ],
      "hidden": false,
      "description": "Sets Ninja generator, Clang compilers, x64 architecture, Multiple Configurations"
    },
    {
      "name": "Development Windows MSVC",
      "displayName": "Development MSVC",
      "inherits": [
        "ninja-multiconfig-base",
        "development-base",
        "windows-msvc-base"
      ],
      "hidden": false,
      "description": "Sets Ninja generator, MSVC compilers, x64 architecture, Multiple Configurations"
    },
    {
      "name": "Minimal MacOS",
      "displayName": "Minimal",
      "inherits": [
        "ninja-multiconfig-base",
        "minimal-base",
        "macos-clang-base"
      ],
      "hidden": false,
      "description": "Sets Ninja generator, Clang compilers, arm64 architecture, Multiple Configurations"
    },
    {
      "name": "Minimal MacOS (Vulkan)",
      "displayName": "Minimal Vulkan",
      "inherits": [
        "ninja-multiconfig-base",
        "minimal-base",
        "macos-clang-base"
      ],
      "hidden": false,
      "description": "Sets Ninja generator, Clang compilers, arm64 architecture, Multiple Configurations",
      "cacheVariables": {
        "LOON_GPU_USE_KOSMICKRISP": "YES"
      }
    },
    {
      "name": "Development MacOS",
      "displayName": "Development",
      "inherits": [
        "ninja-multiconfig-base",
        "development-base",
        "macos-clang-base"
      ],
      "hidden": false,
      "description": "Sets Ninja generator, Clang compilers, arm64 architecture, Multiple Configurations"
    },
    {
      "name": "Development MacOS (Vulkan)",
      "displayName": "Development Vulkan",
      "inherits": [
        "ninja-multiconfig-base",
        "development-base",
        "macos-clang-base"
      ],
      "hidden": false,
      "description": "Sets Ninja generator, Clang compilers, arm64 architecture, Multiple Configurations",
      "cacheVariables": {
        "LOON_GPU_USE_KOSMICKRISP": "YES"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug Windows Clang",
      "displayName": "Debug",
      "hidden": false,
      "configuration": "Debug",
      "configurePreset": "Development Windows Clang"
    },
    {
      "name": "RelWithDebInfo Windows Clang",
      "displayName": "RelWithDebInfo",
      "hidden": false,
      "configuration": "RelWithDebInfo",
      "configurePreset": "Development Windows Clang"
    },
    {
      "name": "Release Windows Clang",
      "displayName": "Release",
      "hidden": false,
      "configuration": "Release",
      "configurePreset": "Development Windows Clang"
    },
    {
      "name": "Debug Windows MSVC",
      "displayName": "MSVC Debug",
      "hidden": false,
      "configuration": "Debug",
      "configurePreset": "Development Windows MSVC"
    },
    {
      "name": "RelWithDebInfo Windows MSVC",
      "displayName": "MSVC RelWithDebInfo",
      "hidden": false,
      "configuration": "RelWithDebInfo",
      "configurePreset": "Development Windows MSVC"
    },
    {
      "name": "Debug MacOS",
      "displayName": "Debug",
      "hidden": false,
      "configuration": "Debug",
      "configurePreset": "Development MacOS"
    },
    {
      "name": "RelWithDebInfo MacOS",
      "displayName": "RelWithDebInfo",
      "hidden": false,
      "configuration": "RelWithDebInfo",
      "configurePreset": "Development MacOS"
    }
  ],
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23
  }
}